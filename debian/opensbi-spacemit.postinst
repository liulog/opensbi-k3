#!/bin/sh
set -e

case "$1" in
configure)
    target=""
    if grep -q 'Spacemit(R) X100' /proc/cpuinfo; then
        target="spacemit"
    else
        echo "no 'Spacemit(R) X100' found in /proc/cpuinfo."
        echo "This may indicate that you are installing this package in a chroot environment."
        exit 0
    fi

    for x in $(cat /proc/cmdline); do
        case $x in
        root=UUID=*)
            ROOT=${x#root=UUID=}
            DEVICES=$(blkid -s UUID | grep "$ROOT" | awk '{print $1}')
            DEVICE_COUNT=$(echo "$DEVICES" | wc -l)
            if [ "$DEVICE_COUNT" -gt 1 ]; then
                echo "Warning: Multiple devices found with the same UUID $ROOT:"
                echo "$DEVICES"
                echo "This may cause installation issues. Please ensure unique UUIDs."
                exit 0
            fi
            ROOT=$(echo "$DEVICES" | head -n1)
            ;;
        root=*)
            ROOT=${x#root=}
            ;;
        esac
    done

    if [ -n $ROOT ]; then
        case $ROOT in
        "/dev/mmcblk0"*)
            OPENSBI_MOUNT="/dev/mmcblk0p1"
            OPENSBI_COPY_MODE=1
            ;;
        "/dev/mmcblk2"*)
            OPENSBI_MOUNT="/dev/mmcblk2p1"
            OPENSBI_COPY_MODE=1
            ;;
        "/dev/sda"*)
            OPENSBI_MOUNT="/dev/sda1"
            OPENSBI_COPY_MODE=1
            ;;
        "/dev/nvme0n1"*)
            if [ -e "/dev/mtdblock5" ]; then
                # nor + ssd
                OPENSBI=/dev/mtdblock5
                # 以KB为单位
                OPENSBI_SEEK=0
            elif [ -e "/dev/mtdblock0" ]; then
                # nor + ssd
                OPENSBI=/dev/mtdblock0
                # 以KB为单位
                OPENSBI_SEEK=1728
            else
                # emmc + ssd
                OPENSBI=/dev/mmcblk2
                # 以KB为单位
                OPENSBI_SEEK=1728
            fi
            ;;
        *)
            echo "Unsupported root=$ROOT"
            exit 1
            ;;
        esac
    else
        echo "Missing root= in cmdline"
        exit 1
    fi

    # 待检查文件列表
    files="/usr/lib/riscv64-linux-gnu/opensbi/generic/fw_dynamic.itb"
    if [ -n "$OPENSBI_COPY_MODE" ]; then
        files="$files $OPENSBI_MOUNT"
    else
        files="$files $OPENSBI"
    fi
    for file in $files; do
        if [ ! -e "$file" ]; then
            # 任意不存在则退出
            echo "Missing $file"
            exit 1
        fi
    done

    # 此前已经做了所有检查
    set -x
    if [ -n "$OPENSBI_COPY_MODE" ]; then
        # 文件复制模式：挂载分区并复制文件
        mkdir -p /mnt/opensbi-install
        mount $OPENSBI_MOUNT /mnt/opensbi-install
        cp /usr/lib/riscv64-linux-gnu/opensbi/generic/fw_dynamic.itb /mnt/opensbi-install/opensbi.itb
        sync
        umount /mnt/opensbi-install
        rmdir /mnt/opensbi-install
    else
        # 直接写入模式
        dd if=/usr/lib/riscv64-linux-gnu/opensbi/generic/fw_dynamic.itb of=$OPENSBI seek=$OPENSBI_SEEK bs=1K && sync
    fi
    set +x
    ;;
esac

exit 0
