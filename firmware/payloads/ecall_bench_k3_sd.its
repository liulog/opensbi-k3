/dts-v1/;

/ {
	description = "OpenSBI ECALL benchmark with built-in S-mode payload";
	#address-cells = <2>;
	fit,fdt-list = "of-list";

	images {
		opensbi {
			description = "OpenSBI fw_payload ECALL benchmark";
			type = "firmware";
			os = "opensbi";
			arch = "riscv";
			compression = "none";
			load = <0x1 0x0>;
			entry = <0x1 0x0>;
			data = /incbin/("./fw_payload.bin");
			hash-1 {
				algo = "crc32";
			};
		};
	};

	configurations {
		default = "config_1";

		config_1 {
			description = "OpenSBI ECALL benchmark FIT config";
			firmware = "opensbi";
		};
	};
};
